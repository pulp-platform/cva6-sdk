From 189fa2ad01c488eaed839b44b574ce64c1177829 Mon Sep 17 00:00:00 2001
From: Cyril Koenig <cyril27koenig@gmail.com>
Date: Wed, 16 Jul 2025 13:52:11 +0200
Subject: [PATCH 4/4] Enable LLC for faster boot on Cheshire

---
 platform/fpga/cheshire/platform.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/platform/fpga/cheshire/platform.c b/platform/fpga/cheshire/platform.c
index 25f4db7..e5bb4bc 100644
--- a/platform/fpga/cheshire/platform.c
+++ b/platform/fpga/cheshire/platform.c
@@ -78,6 +78,9 @@ static int cheshire_early_init(bool cold_boot)
 	rc = fdt_parse_uart8250(fdt, &uart_data, "ns16550a");
 	if (!rc)
 		uart = uart_data;
+	
+	*(uint32_t*)0x3001000=0x0;
+	*(uint32_t*)0x3001010=0x1;
 
 	return 0;
 }
