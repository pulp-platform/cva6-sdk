From 1adababbe53421528a2ca8909a8abcf2c587bc9e Mon Sep 17 00:00:00 2001
From: Cyril Koenig <cykoenig@iis.ee.ethz.ch>
Date: Wed, 6 Dec 2023 11:11:12 +0100
Subject: [PATCH 16/17] Boot command compatible with ethernet/spi/sdcard

---
 configs/pulp-platform_cheshire_defconfig | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/configs/pulp-platform_cheshire_defconfig b/configs/pulp-platform_cheshire_defconfig
index a397951497..1b33ee00d9 100644
--- a/configs/pulp-platform_cheshire_defconfig
+++ b/configs/pulp-platform_cheshire_defconfig
@@ -12,8 +12,10 @@ CONFIG_BOOTDELAY=5
 CONFIG_HUSH_PARSER=y
 CONFIG_USE_BOOTCOMMAND=y
 # Boot with mmc if mmc probes normally, else boot with spi (get CS from "boot-with" in device tree)
-CONFIG_BOOTCOMMAND="fdt addr ${fdtcontroladdr}; dhcp 0x90000000 129.132.24.199:vcu128-01/carfield/uImage; bootm 90000000 - ${fdtcontroladdr};"
-CONFIG_DISPLAY_CPUINFO=y
+CONFIG_BOOTCOMMAND="fdt addr ${fdtcontroladdr}; \
+if fdt get value tmpvar /soc/eth0 compatible; then dhcp 0x90000000 129.132.24.199:vcu128-01/carfield/uImage; bootm 90000000 - ${fdtcontroladdr}; fi; \
+if fdt get value boot-with /soc/spi; then sf probe 0:${boot-with}; sf read 90000000 400000 800000; bootm 90000000 - ${fdtcontroladdr}; fi; \
+if mmc info; then mmc read 90000000 2000 5000; bootm 90000000 - ${fdtcontroladdr}; fi;"
 CONFIG_SPL_SPI_FLASH_MTD=y
 CONFIG_CMD_GPT=y
 # CONFIG_RANDOM_UUID is not set
-- 
2.43.5

