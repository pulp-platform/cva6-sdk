From 612bedeaa230650c18736aa695bbab3b04b620a7 Mon Sep 17 00:00:00 2001
From: Cyril Koenig <cykoenig@iis.ee.ethz.ch>
Date: Fri, 20 Oct 2023 11:55:19 +0200
Subject: [PATCH 15/17] carfield: Making flash larger for libomp.so

---
 configs/pulp-platform_cheshire_defconfig | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/configs/pulp-platform_cheshire_defconfig b/configs/pulp-platform_cheshire_defconfig
index b2af8119f8..a397951497 100644
--- a/configs/pulp-platform_cheshire_defconfig
+++ b/configs/pulp-platform_cheshire_defconfig
@@ -6,11 +6,13 @@ CONFIG_RISCV_SMODE=y
 CONFIG_OF_LIBFDT=y
 CONFIG_OF_BOARD_SETUP=y
 CONFIG_OF_PRIOR_STAGE=y
+CONFIG_PROT_UDP=y
+CONFIG_NET_RANDOM_ETHADDR=y
 CONFIG_BOOTDELAY=5
 CONFIG_HUSH_PARSER=y
 CONFIG_USE_BOOTCOMMAND=y
 # Boot with mmc if mmc probes normally, else boot with spi (get CS from "boot-with" in device tree)
-CONFIG_BOOTCOMMAND="fdt addr ${fdtcontroladdr}; if mmc info; then mmc read 90000000 2000 5000; else fdt get value boot-with /soc/spi boot-with; if sf probe 0:${boot-with}; then sf read 90000000 400000 800000; fi; fi; bootm 90000000 - ${fdtcontroladdr};"
+CONFIG_BOOTCOMMAND="fdt addr ${fdtcontroladdr}; dhcp 0x90000000 129.132.24.199:vcu128-01/carfield/uImage; bootm 90000000 - ${fdtcontroladdr};"
 CONFIG_DISPLAY_CPUINFO=y
 CONFIG_SPL_SPI_FLASH_MTD=y
 CONFIG_CMD_GPT=y
@@ -18,6 +20,7 @@ CONFIG_CMD_GPT=y
 CONFIG_CMD_MMC=y
 CONFIG_CMD_MTD=y
 CONFIG_CMD_PART=y
+CONFIG_CMD_DHCP=y
 CONFIG_OF_EMBED=n
 CONFIG_MMC=y
 # CONFIG_MMC_WRITE is not set
@@ -40,6 +43,12 @@ CONFIG_SPI_FLASH_WINBOND=y
 CONFIG_SPI_FLASH_XMC=y
 # CONFIG_SPI_FLASH_USE_4K_SECTORS is not set
 CONFIG_SPI_FLASH_MTD=y
+CONFIG_PHY_TI_DP83867=y
+CONFIG_PHY_XILINX=y
+CONFIG_DM_MDIO=y
+CONFIG_DM_ETH_PHY=y
+CONFIG_XILINX_AXIEMAC=y
+CONFIG_PHY=y
 CONFIG_BAUDRATE=38400
 CONFIG_SYS_NS16550=y
 CONFIG_SPI=y
-- 
2.43.5

