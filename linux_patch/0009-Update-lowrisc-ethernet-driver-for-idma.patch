+/*
+ * Helper to drain one ready RX packet while holding priv->dma_lock.
+ * Uses the exact V 0.4 RX hardware sequence plus waiting for RSP_VALID
+ * to deassert so rx_complete is guaranteed to clear before the next check.
+ */
+static struct sk_buff *lowrisc_rx_one_locked(struct net_local *priv)
+{
+  struct net_device *ndev = priv->ndev;
+  uint32_t rx_timeout = REQ_READY_TIMEOUT;
+  uint32_t valid_timeout = RSP_VALID_TIMEOUT;
+  struct sk_buff *skb;
+  int len, rnd;
+
+  if (!(eth_read(priv, RSR_OFFSET) & RSR_RECV_DONE_MASK))
+    return NULL;
+
+  lowrisc_wait_rsp_clear(priv);
+
+  if (!(eth_read(priv, RSR_OFFSET) & RSR_RECV_DONE_MASK))
+    return NULL;
+
+  len = eth_read(priv, DMA_LENGTH_OFFSET);
+  if (unlikely(len <= 0 || len > ETH_FRAME_LEN + ETH_FCS_LEN)) {
+    ndev->stats.rx_errors++;
+    return NULL;
+  }
+
+  rnd = ((len - 1) | 7) + 1; /* Round up to multiple of 8 */
+  skb = netdev_alloc_skb(ndev, rnd + 8);
+  if (unlikely(!skb)) {
+    ndev->stats.rx_dropped++;
+    return NULL;
+  }
+
+  align_skb_data(skb);
+  lowrisc_set_idma_for_rx(priv, skb->data);
+
+  while (!eth_read(priv, REQ_READY_OFFSET)) {
+    if (!rx_timeout) {
+      dev_kfree_skb_any(skb);
+      pr_err("Timeout waiting for RX REQ_READY\n");
+      ndev->stats.rx_errors++;
+      return NULL;
+    }
+    rx_timeout--;
+  }
+
+  eth_write(priv, REQ_VALID_OFFSET, 1);
+
+  while (valid_timeout > 0) {
+    if (eth_read(priv, RSP_VALID_OFFSET))
+      break;
+    valid_timeout--;
+  }
+
+  lowrisc_wait_rsp_clear(priv);
+
+  if (unlikely(valid_timeout == 0)) {
+    pr_err("DMA RX timed out waiting for RSP_VALID\n");
+    dev_kfree_skb_any(skb);
+    ndev->stats.rx_errors++;
+    return NULL;
+  }
+
+  skb_put(skb, len);
+  skb->protocol = eth_type_trans(skb, ndev);
+  ndev->stats.rx_packets++;
+  ndev->stats.rx_bytes += len;
+  return skb;
+}
